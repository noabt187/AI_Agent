{
  "name": "agent-query-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "ai-agent": "dist/scripts/ai-agent.js"
  },
  "workspaces": [
    "web",
    "bundles/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/**/*.test.ts tests/**/*.test.tsx",
    "test:pagecraft-plugin": "node --import tsx --test tests/pagecraft-plugin.integration.test.ts tests/pagecraft-client.integration.test.tsx",
    "ai-agent": "tsx scripts/ai-agent.ts",
    "orchestrator": "tsx scripts/orchestrator-chat.ts",
    "predev": "npm run dev:cleanup",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:cleanup": "node scripts/cleanup-dev-ports.mjs",
    "dev:server": "tsx watch src/server/server.ts",
    "dev:web": "npm --workspace web run dev",
    "build:web": "npm --workspace web run build"
  },
  "dependencies": {
    "@ai-agent/base": "file:bundles/base",
    "@ai-agent/web-app": "file:bundles/web-app",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.6",
    "js-yaml": "4.2.0",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.19.19",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2"
  }
}
